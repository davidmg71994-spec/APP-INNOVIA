<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="es.visitasprl.registro">

    <!-- La app funciona sin conexión y no envía datos: el código bloquea toda petición a otro servidor.
         Se mantiene este permiso porque el componente WebView de Android lo necesita para funcionar. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Visita manos libres (1.22.0): escuchar las respuestas. Solo se usa mientras está activada. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Para abrir la cámara del móvil desde la app (Android 11 o superior). -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- Visita manos libres: reconocimiento de voz y lectura en voz alta del sistema. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/extraccion"
        android:usesCleartextTraffic="false"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|smallestScreenSize|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fotos de la cámara y archivos para compartir (PDF, copias de seguridad). -->
        <provider
            android:name=".ArchivosProvider"
            android:authorities="es.visitasprl.registro.archivos"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
